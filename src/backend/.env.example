# Copy this file to .env (same folder) and fill in your own values.
# Never commit or share .env: it holds your API key and passwords.
# Do NOT put QUERY_MODE here. Set it when you start the server (see docs/SETUP_GUIDE.md, Step 8).

# AI provider: Gemini (free key from aistudio.google.com) or Claude (CLAUDE_API_KEY=...)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# MySQL. DB_NAME is used by legacy mode only: AIplane (old sample) or AIplane_v2 (baseline testing)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=AIplane_v2

# Read-only user for the seatac views (views and templates modes). Pick any strong password:
# the database tests create or reset the seatac_reader user with it.
SEATAC_READER_PASSWORD=
